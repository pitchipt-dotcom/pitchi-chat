# Optional: export these variables in your shell. .env is not loaded automatically.
# PITCH_CHAT_CONFIG=/absolute/path/to/settings.toml
# PITCH_CHAT_MODEL_API_KEY=your-local-service-key
# PITCH_CHAT_BONSAI_API_KEY=your-local-service-key
# PITCH_CHAT_QWEN80B_API_KEY=<owned-local-model-key-if-required>
# PITCH_CHAT_HOST=127.0.0.1
# PITCH_CHAT_PORT=8000
# PITCH_CHAT_SERVICES_CONFIG=/absolute/path/to/services.local.toml
# PITCH_CHAT_RESOURCES_CONFIG=/absolute/path/to/resources.local.toml
# PITCH_CHAT_IMAGES_CONFIG=/absolute/path/to/images.local.toml
# PITCH_CHAT_IRODORI_API_KEY=<local-service-key-if-required>
# PITCH_CHAT_CLOUD_CONFIG=/absolute/path/to/cloud.local.toml
# PITCH_CHAT_OPENAI_REASONING_KEY=<reasoning-provider-key>
# PITCH_CHAT_OPENAI_RENDERER_KEY=<renderer-provider-key>
# PITCH_CHAT_WORK_CONFIG=/absolute/path/to/work.local.toml
# Service URLs belong in that ignored TOML, not in source or this example.
# ui_url = "https://<service-host>:<port>/"
# api_base_url = "https://<verified-api-host>:<port>/"
# PITCH_CHAT_GUIDELINES_CONFIG=/absolute/path/to/guidelines.local.toml
